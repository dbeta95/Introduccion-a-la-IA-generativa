# ==============================================================================
# Environment Variables Reference (sample.env)
# Copy this file to .env and fill in your actual API keys:
# cp sample.env .env
# ==============================================================================

# Google AI Studio / Gemini API Key
# Obtain your key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# GOOGLE_API_KEY is also accepted by LangChain (langchain-google-genai)
GOOGLE_API_KEY="your_gemini_api_key_here"

# Groq Cloud API Key
# Obtain your key here: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"
